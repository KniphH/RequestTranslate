{
  "name": "request-translate",
  "private": true,
  "type": "module",
  "description": "Edge/Chromium 扩展：用一段可自由编辑的 HTTP 请求作为翻译配置。仅用于本地开发与测试脚本。",
  "scripts": {
    "check": "node tools/check-globals.mjs && node tools/check-dom.mjs",
    "check:globals": "node tools/check-globals.mjs",
    "check:dom": "node tools/check-dom.mjs",
    "test": "node tools/check-globals.mjs && node tools/check-dom.mjs && node tools/test-lib.mjs && node tools/test-engine.mjs && node tools/test-strip.mjs && node tools/e2e-ui.mjs && node tools/test-pack-fixture.mjs && node tools/test-summary.mjs",
    "test:lib": "node tools/test-lib.mjs",
    "test:engine": "node tools/test-engine.mjs",
    "test:strip": "node tools/test-strip.mjs",
    "test:ui": "node tools/e2e-ui.mjs",
    "perf": "node tools/perf-probe.mjs",
    "icons": "python tools/make-icons.py",
    "colors": "node tools/generate-m3-palettes.mjs",
    "pack": "python tools/pack.py && python tools/verify-pack.py",
    "verify:pack": "python tools/verify-pack.py",
    "pack:crx": "python tools/pack.py --crx",
    "test:fixture": "node tools/test-pack-fixture.mjs",
    "test:m3": "node tools/e2e-m3.mjs",
    "test:panel": "node tools/e2e-panel-redesign.mjs",
    "test:scrollbar": "node tools/e2e-scrollbar-theme.mjs",
    "test:security-ui": "node tools/e2e-security-redaction.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.1"
  }
}
